# Токен бота от @BotFather
BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID общего группового чата (бот должен быть в нём добавлен).
# Узнать можно, например, переслав сообщение из группы боту @userinfobot
GROUP_CHAT_ID=-1001234567890

# Три участницы: telegram_id:Имя, через запятую. telegram_id узнать через @userinfobot
WHITELIST_USERS=111111111:Аня,222222222:Катя,333333333:Маша

# Путь к файлу SQLite (для Railway можно оставить как есть — файл будет жить в volume)
DB_PATH=data/habit.db

# Публичный URL приложения на Railway, куда будет вести кнопка Mini App.
# Локально можно оставить пустым — кнопка Mini App работать не будет, но бот и API запустятся.
WEBAPP_URL=

# Часы напоминаний (по Europe/Moscow)
MORNING_REMINDER_HOUR=9
EVENING_REMINDER_HOUR=21
